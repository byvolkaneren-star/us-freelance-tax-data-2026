  "conformity": {
    "seDeduction": {
      "allowed": true,
      "note": "Connecticut starts from federal AGI, which already reflects the deductible half of SE tax."
    },
    "seHealthInsurance": {
      "allowed": true,
      "note": "Inherited through federal AGI."
    },
    "retirementContributions": {
      "allowed": true,
      "note": "SEP-IRA and solo 401(k) contributions deducted in federal AGI carry through."
    },
    "qbi": {
      "allowed": false,
      "note": "The QBI deduction is taken after federal AGI; Connecticut has no equivalent."
    }
  },
  "localIncomeTax": {
    "exists": false,
    "note": "Connecticut municipalities do not levy local income taxes."
  },
  "estimatedTax": {
    "required": true,
    "threshold": "Required if your 2026 Connecticut income tax after withholding and any pass-through entity tax credit is $1,000 or more and you expect withholding (plus PE tax credit) to be less than your required annual payment (2026 Form CT-1040ES). Not required if you were a resident in 2025 and did not file a 2025 return because you had no Connecticut tax liability.",
    "dueDates": [
      "2026-04-15",
      "2026-06-15",
      "2026-09-15",
      "2027-01-15"
    ],
    "safeHarbor": "Required annual payment is the lesser of 90% of 2026 Connecticut income tax or 100% of 2025 Connecticut income tax (12-month return), paid in four 25% installments (66 2/3% for farmers and fishermen). Underpayment interest is 1% per month (Form CT-2210); filing and paying in full by January 31, 2027 removes interest on the January installment. Annualized-income method available.",
    "form": "Form CT-1040ES (or myconneCT)"
  },
  "businessCosts": {
    "llcFormationFee": "$120 Certificate of Organization, including appointment of registered agent (Conn. Gen. Stat. 34-243u(a)(3)).",
    "annualReportFee": "$80 annual report for an LLC, due every year (Conn. Gen. Stat. 34-243u(a)(15)(B), years on or after July 1, 2020).",
    "franchiseOrMinimumTax": "None: the $250 business entity tax no longer applies for income years beginning on or after January 1, 2020 (P.A. 19-117; statute text not re-read on 2026-10-22). The pass-through entity tax is elective.",
    "grossReceiptsTax": "None."
  },
